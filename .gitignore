# Python
__pycache__/
*.py[cod]
*.egg-info/

# uv / 虚拟环境
.venv/
.uv/

# 打包产物
build/
dist/
# spec 默认是命令行生成的一次性文件,所以忽略;
# 但 stabar.spec 是手写维护的构建配置(带 Qt 裁剪逻辑),必须进版本库
*.spec
!stabar.spec

# 运行时生成的配置与日志(位置随运行方式变化,见 日志使用说明.md)
# 日志只有一份:超限是清空重写,不产生 stabar.log.1 之类的历史文件
stabar.ini
stabar.log

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db
